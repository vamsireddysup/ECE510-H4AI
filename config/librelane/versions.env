# Pinned LibreLane toolchain. scripts/install_librelane.sh and
# scripts/run_librelane.sh read these; record any change in the results record.
LIBRELANE_VERSION=3.0.14
# The ciel release LibreLane 3.0.14 resolves (it requires ciel>=2.3.1,<3).
CIEL_VERSION=2.6.1
# The Sky130 open_pdks revision LibreLane 3.0.14 declares in pdk_hashes.yaml.
SKY130_PDK_REVISION=8afc8346a57fe1ab7934ba5a6056ea8b43078e71
# The image LibreLane --dockerized pulls for this version.
LIBRELANE_IMAGE=ghcr.io/librelane/librelane:3.0.14
